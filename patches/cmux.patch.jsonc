  // Settings this tooling relies on, pinned as file-managed so a change in the Settings UI
  // cannot silently break it. Every entry ends with a comma: install.sh inserts this block
  // before "schemaVersion" in ~/.config/cmux/cmux.json.
  //   app.reorderOnNotification   the workspaces sidebar keeps pinned cards above the ones
  //                               cmux reorders when they notify; it assumes reordering is on.
  //   automation.claudeCodeIntegration   cw starts claude through cmux's per-surface claude
  //                               wrapper; that wrapper only exists with the integration on.
  //   automation.socketControlMode / socketPassword   cw also runs from terminals cmux did
  //                               not start (and starts cmux when it is not running). The
  //                               default mode, cmuxOnly, refuses those; password mode admits
  //                               any local process that presents the password. install.sh
  //                               generates it into ~/.config/cmux/socket-password and fills
  //                               it in below until cmux has taken it: cmux moves the value
  //                               to its own store and rewrites this file, after which
  //                               install.sh leaves the socketPassword line out.
  "app": {
    "reorderOnNotification": true
  },
  "automation": {
    "claudeCodeIntegration": true,
    "socketPassword": "@SOCKET_PASSWORD@",
    "socketControlMode": "password"
  },
